EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_DEMO=false
# Evidence is always taken through the camera. This only has any effect in a
# development build: a release bundle ignores it, so a shipped app cannot
# accept a library photo as evidence. Set to "library" to work on a simulator,
# which has no camera.
EXPO_PUBLIC_PHOTO_SOURCE=camera
