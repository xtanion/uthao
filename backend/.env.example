ENVIRONMENT=development
# Refuses to start outside development while this is the built-in default.
SECRET_KEY=development-only-secret-key-replace-before-deploying

# SQLite by default. Postgres: postgresql+asyncpg://user:pass@host/fihy
# (install the extra: uv sync --extra postgres)
DATABASE_URL=sqlite+aiosqlite:///./fihy.db

# Runs `alembic upgrade head` at startup. Turn this off wherever more than one
# worker can boot at once and run the upgrade as a deploy step instead.
AUTO_MIGRATE=true

# Where the mobile app reaches this service. Used to build /media links when
# R2 is not configured.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Cloudflare R2. Leave blank in development and images go to MEDIA_ROOT on disk,
# served from /media with the same short-lived signed-link behaviour.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fihy
# Only needed for a non-default endpoint; otherwise derived from R2_ACCOUNT_ID.
R2_ENDPOINT_URL=
SIGNED_URL_TTL_SECONDS=600
MEDIA_ROOT=./var/media

# Reports are accepted inside this box only. Defaults to all of India.
GEOFENCE_ENABLED=true
GEOFENCE_MIN_LATITUDE=6.0
GEOFENCE_MAX_LATITUDE=37.6
GEOFENCE_MIN_LONGITUDE=68.0
GEOFENCE_MAX_LONGITUDE=97.5

# Long-lived by default because the app holds one access token and has no
# refresh interceptor. Shorten this only alongside a client change.
ACCESS_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_TTL_SECONDS=7776000

# A report is confirmed once this many people other than the reporter have
# supported it *with a photo*. A tap is not evidence; a camera is.
PHOTO_SUPPORTS_TO_CONFIRM=2
# How long after confirmation the report is handed back to the people who filed
# it, if nothing else has moved. The fix-date poll opens then.
CONTRIBUTIONS_AFTER_DAYS=5
MAX_FIX_DATES_PER_ISSUE=5

# Named on every letter to an authority until ward boundaries can say which
# body actually owns a given location.
DEFAULT_AUTHORITY=the municipal corporation
# Comma separated. "*" is fine while the only client is a native app carrying a
# bearer token; narrow it before there is a web one.
CORS_ORIGINS=*
# The interactive docs are off outside development unless this says otherwise.
PUBLIC_DOCS=false
# A confirmed report waits this long before being raised, so the community has
# a chance to add to it first.
ESCALATE_AFTER_HOURS=24
ESCALATE_BATCH_SIZE=25
CHECK_BATCH_SIZE=100

# Letters go out from fihy's own domain carrying the reporter's name. They
# cannot go out *as* the reporter: a message with their address in From, sent
# from this server, fails DMARC and is rejected.
MAIL_FROM_DOMAIN=
MAIL_FROM_NAME=fihy
# Where replies land. A subdomain pointed at the mail provider's inbound parse.
MAIL_REPLY_DOMAIN=
# Where letters are addressed. Blank and nothing is sent.
AUTHORITY_EMAIL=
MAX_LETTER_ATTACHMENTS=3

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# The provider signs its webhook posts with this; without it /webhooks/* is 503.
INBOUND_MAIL_SECRET=
# A signed post more than this far from now is refused as a replay.
WEBHOOK_TOLERANCE_SECONDS=300
# A new report within this many metres of an existing one, in the same
# category, is offered as somewhere to add your photo instead.
DUPLICATE_RADIUS_M=100
# A support carrying photos must be sent from within this many metres of the
# report: the duplicate radius plus room for two phones' GPS error.
SUPPORT_RADIUS_M=150

# Plain-language summaries of an issue and its replies. Leave the key blank
# and summaries are simply off: ai_summary stays null and the UI hides it.
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-opus-5
# However many people reply, a summary is rewritten at most this often.
AI_SUMMARY_MIN_INTERVAL_SECONDS=300

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_PHONE_PER_HOUR=5
OTP_REQUESTS_PER_IP_PER_HOUR=20
# The header your edge proxy puts the caller's address in: fly-client-ip on
# Fly, cf-connecting-ip behind Cloudflare. Blank uses the connecting address.
CLIENT_IP_HEADER=
# Writes are capped per account too. Only OTP was ever limited, which left
# somebody signed in free to flood the feed.
REPORTS_PER_USER_PER_HOUR=10
SUPPORTS_PER_USER_PER_HOUR=60
# Both OTP tables hold verified phone numbers. Rows older than this are pruned
# by `python -m app.jobs prune`.
OTP_RETENTION_HOURS=72
# Accepts this code for any phone and sends no SMS. Development only; leave
# blank and the code is written to the log instead.
OTP_DEBUG_CODE=
