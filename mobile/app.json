{
  "expo": {
    "name": "fihy",
    "slug": "fihy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xtanion.fihy",
      "infoPlist": {
        "NSCameraUsageDescription": "Uthao uses your camera to document civic problems with evidence.",
        "NSLocationWhenInUseUsageDescription": "Uthao uses your location to place reports accurately and show nearby issues.",
        "NSPhotoLibraryUsageDescription": "Uthao lets you attach evidence from your photo library to a report."
      },
      "appleTeamId": "Z7JCWW3N99",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xtanion.fihy",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "activity",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "./plugins/withSceneLifecycle",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth"
            ]
          }
        }
      ]
    ],
    "scheme": "fihy",
    "extra": {
      "appStoreUrl": ""
    }
  }
}
